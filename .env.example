# --- Telephony provider: "twilio" (self-built pipeline) or "vapi" (managed end-to-end) ---
TELEPHONY_PROVIDER=twilio

# --- Twilio (used when TELEPHONY_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15555550123

# --- Vapi (used when TELEPHONY_PROVIDER=vapi). One key + a phone number id from the dashboard. ---
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
VAPI_TRANSCRIBER_PROVIDER=deepgram
VAPI_TRANSCRIBER_MODEL=nova-2
VAPI_MAX_DURATION_SECONDS=600

# --- LLM (used by the Twilio pipeline; Vapi uses its own LLM) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- TTS (used by the Twilio pipeline). Leave blank to fall back to Twilio <Say> (Polly) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- App ---
# Public base URL (e.g. ngrok https URL) required for Twilio provider; optional for Vapi (status webhook only)
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
HOST=0.0.0.0
PORT=8000
